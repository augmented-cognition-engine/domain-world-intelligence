{
  "contract": "ace.world-intelligence.ai-source-catalog/v1alpha2",
  "topic_id": "artificial_intelligence",
  "display_name": "AI Command Center",
  "purpose": "A reviewed source universe for onboarding an AI intelligence deployment across technology, economics, infrastructure, institutions, and adoption.",
  "selection_policy": {
    "primary_sources_first": true,
    "publisher_roots_must_remain_distinct": true,
    "republication_does_not_count_as_corroboration": true,
    "provider_claims_require_independent_evidence_for_comparative_conclusions": true,
    "discovery_sources_must_be_resolved_to_citable_evidence": true,
    "licensed_enrichment_must_retain_provider_and_license_lineage": true,
    "proposed_sources_are_not_admitted_evidence": true,
    "human_review_required_before_connection": true
  },
  "evidence_roles": {
    "authoritative_record": "A law, filing, contract, official statistic, or other controlling public record.",
    "first_party_claim": "A provider or organization describing its own product, plans, performance, or position.",
    "operational_telemetry": "A status, availability, usage, download, price, or incident observation generated by an operating system.",
    "independent_measurement": "A third party's reproducible evaluation, benchmark, survey, or measurement.",
    "leading_indicator": "A hiring, patent, research, procurement, or infrastructure record that may precede a public strategy announcement.",
    "discovery_only": "A source used to find candidate developments; it cannot independently establish a Brief claim.",
    "private_organizational": "Customer-owned telemetry or records admitted only inside the customer's authority boundary."
  },
  "demo_waves": {
    "wave_0_connected": "Existing governed source definitions with admitted recorded captures.",
    "wave_1_public": "Credential-free or low-friction public sources for the flagship live demonstration.",
    "wave_2_enrichment": "Broader public, API-key, licensed, and customer-owned enrichment after the first live demo."
  },
