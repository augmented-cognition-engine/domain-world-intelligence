{
  "contract": "ace.world-intelligence.ai-source-catalog/v1alpha1",
  "topic_id": "artificial_intelligence",
  "display_name": "AI Command Center",
  "purpose": "A reviewed portfolio of primary sources an onboarding agent can propose for an AI intelligence deployment.",
  "selection_policy": {
    "primary_sources_first": true,
    "publisher_roots_must_remain_distinct": true,
    "republication_does_not_count_as_corroboration": true,
    "proposed_sources_are_not_admitted_evidence": true,
    "human_review_required_before_connection": true
  },
  "watch_areas": [
    {
      "watch_id": "models_and_capabilities",
      "display_name": "Models & capabilities",
      "question": "What materially changed in model capability, availability, evaluation, or product form?",
      "sources": [
        {
          "source_id": "openai_news",
          "publisher": "OpenAI",
          "uri": "https://openai.com/news/",
          "source_class": "provider_primary",
          "connection_state": "proposed",
          "refresh_cadence": "daily"
        },
        {
          "source_id": "anthropic_news",
          "publisher": "Anthropic",
          "uri": "https://www.anthropic.com/news",
          "source_class": "provider_primary",
          "connection_state": "proposed",
          "refresh_cadence": "daily"
        },
        {
          "source_id": "google_deepmind_news",
          "publisher": "Google DeepMind",
          "uri": "https://deepmind.google/blog/",
          "source_class": "provider_primary",
          "connection_state": "proposed",
          "refresh_cadence": "daily"
        },
        {
          "source_id": "google_deepmind_model_cards",
          "publisher": "Google DeepMind",
          "uri": "https://deepmind.google/models/model-cards/",
          "source_class": "provider_primary",
          "connection_state": "proposed",
          "refresh_cadence": "weekly"
        },
        {
          "source_id": "meta_ai_blog",
          "publisher": "Meta AI",
          "uri": "https://ai.meta.com/blog/",
          "source_class": "provider_primary",
          "connection_state": "proposed",
          "refresh_cadence": "daily"
        }
      ]
    },
    {
      "watch_id": "economics_and_pricing",
      "display_name": "Economics & pricing",
      "question": "How are token prices, inference economics, context limits, and commercial terms changing?",
      "sources": [
        {
          "source_id": "openai_api_pricing",
          "publisher": "OpenAI",
          "uri": "https://openai.com/api/pricing/",
          "source_class": "provider_commercial_primary",
          "connection_state": "proposed",
          "refresh_cadence": "daily"
        },
        {
          "source_id": "anthropic_api_pricing",
          "publisher": "Anthropic",
          "uri": "https://docs.anthropic.com/en/docs/about-claude/pricing",
          "source_class": "provider_commercial_primary",
          "connection_state": "proposed",
          "refresh_cadence": "daily"
        },
        {
          "source_id": "google_gemini_api_pricing",
          "publisher": "Google",
