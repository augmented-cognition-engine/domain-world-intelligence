  "brief": {
    "brief_template_id": "reality_change_brief",
    "brief_type": "world_intelligence",
    "title": "What changed on Meridia coastal water reliability, 2026-03-10 to 2026-03-13",
    "persona_ids": [
      "general_reader",
      "public_researcher"
    ],
    "persona_status_overrides": [],
    "brief_as_of": "2026-03-13T06:00:00Z",
