    ],
    "statements": [
      {
        "statement_id": "stmt:wh_announcement",
        "section_id": "what_happened",
        "epistemic_status": "observed",
        "text": "On 2026-03-10 the Meridia Water Authority initiated the Accelerated Release Schedule 2026-R1, with coastal reservoir storage at 61.8 percent of capacity.",
        "support_record_ids": [
          "record:mwa_bulletin_214"
        ]
      },
      {
        "statement_id": "stmt:wh_suspension",
        "section_id": "what_happened",
        "epistemic_status": "observed",
        "text": "On 2026-03-12 the Authority suspended the schedule effective 12:00Z pending a basin condition review.",
        "support_record_ids": [
          "record:mwa_order_47"
        ]
      },
      {
        "statement_id": "stmt:wc_event_status",
        "section_id": "what_changed",
        "epistemic_status": "observed",
        "text": "The release program moved from announced to suspended within the 72-hour window.",
        "support_record_ids": [
          "record:mwa_bulletin_214",
          "record:mwa_order_47"
        ]
      },
      {
        "statement_id": "stmt:wc_indicator",
        "section_id": "what_changed",
        "epistemic_status": "observed",
        "text": "Reported reservoir storage fell from 61.8 to 54.2 percent of capacity, a 12.3 percent relative decline.",
        "support_record_ids": [
          "record:basin_gauge_series_w10",
          "record:mwa_bulletin_214"
        ]
      },
      {
        "statement_id": "stmt:wc_correction",
        "section_id": "what_changed",
        "epistemic_status": "observed",
        "text": "The Meridia Ledger corrected its report 1088: release volumes run 14 percent above seasonal norms, not the 40 percent it first printed.",
        "support_record_ids": [
          "record:ledger_correction_114"
        ]
      },
      {
        "statement_id": "stmt:er_records",
        "section_id": "established_records",
        "epistemic_status": "observed",
        "text": "Three official records are admitted: Bulletin 214, the week-10 gauge series, and Order 47. Each remains inspectable with its own publication and ingestion times.",
        "support_record_ids": [
          "record:basin_gauge_series_w10",
          "record:mwa_bulletin_214",
          "record:mwa_order_47"
        ]
      },
      {
        "statement_id": "stmt:ac_marran",
        "section_id": "attributed_claims",
        "epistemic_status": "attributed_claim",
        "text": "Councilor Ivette Marran said the schedule will restore full municipal supply within two weeks. The attribution is part of the claim.",
        "support_record_ids": [
          "record:assembly_transcript_0310"
        ],
        "claim_entity_id": "entity:claim/supply_restoration"
      },
      {
        "statement_id": "stmt:ac_quell",
        "section_id": "attributed_claims",
        "epistemic_status": "attributed_claim",
        "text": "Delegate Tomas Quell said the schedule will cut downstream farm allocations by roughly one third this season. The attribution is part of the claim.",
        "support_record_ids": [
          "record:ledger_report_1088"
        ],
        "claim_entity_id": "entity:claim/farm_allocation_cut"
      },
      {
        "statement_id": "stmt:sa_allocation",
        "section_id": "where_sources_agree",
        "epistemic_status": "corroborated",
        "text": "Quell's allocation claim gains independent support: the Hydrology Office allocation index at 71 against a seasonal norm of 100 comes from a provenance family independent of the Ledger reporting family that first carried the claim.",
        "support_record_ids": [
          "record:basin_gauge_series_w10",
          "record:ledger_report_1088"
        ],
        "claim_entity_id": "entity:claim/farm_allocation_cut",
        "independent_family_ids": [
          "family:basin_hydrology_datasets",
          "family:meridia_ledger_reporting"
        ]
      },
      {
        "statement_id": "stmt:sc_supply",
        "section_id": "where_sources_conflict",
        "epistemic_status": "disputed",
        "text": "Marran's restoration claim is materially contradicted by the gauge series, which shows storage falling and municipal pressure flat rather than recovering.",
        "support_record_ids": [
          "record:assembly_transcript_0310",
          "record:basin_gauge_series_w10"
        ],
        "claim_entity_id": "entity:claim/supply_restoration"
      },
      {
        "statement_id": "stmt:inf_suspension_driver",
        "section_id": "ace_inferences",
        "epistemic_status": "inferred",
        "text": "ACE inference: the suspension most plausibly responds to the storage decline recorded in the week-10 gauge series; Order 47 does not state its motivation.",
        "support_record_ids": [
          "record:basin_gauge_series_w10",
          "record:mwa_order_47"
        ],
        "inference_basis_record_ids": [
          "record:basin_gauge_series_w10",
          "record:mwa_order_47"
        ],
        "uncertainty": "Order 47 names a basin condition review but no cause; other administrative causes cannot be excluded from the admitted evidence."
      },
      {
        "statement_id": "stmt:unk_allocation_outcome",
        "section_id": "unknowns",
        "epistemic_status": "unknown",
        "text": "Whether downstream farm allocations will actually fall by one third this season is unresolved by the admitted evidence.",
        "support_record_ids": [],
        "resolution_watch": "The next seasonal allocation bulletin from the Meridia Water Authority."
      },
      {
        "statement_id": "stmt:unk_resumption",
        "section_id": "unknowns",
        "epistemic_status": "unknown",
        "text": "Whether and when the release schedule resumes is unresolved; Order 47 sets no end date for the basin condition review.",
        "support_record_ids": [],
        "resolution_watch": "Any Meridia Water Authority order following the basin condition review."
      },
      {
        "statement_id": "stmt:wim_context",
        "section_id": "why_it_matters",
        "epistemic_status": "inferred",
        "text": "ACE inference: with storage already down 12.3 percent relative in roughly a day of measurement and the release program suspended, near-term coastal supply decisions will likely be made under tighter constraints than Bulletin 214 assumed.",
        "support_record_ids": [
          "record:basin_gauge_series_w10",
          "record:mwa_bulletin_214"
        ],
        "inference_basis_record_ids": [
          "record:basin_gauge_series_w10",
          "record:mwa_bulletin_214"
        ],
        "uncertainty": "The gauge series covers one week; the drawdown rate may not persist."
      },
      {
        "statement_id": "stmt:wp_rationing_scenario",
        "section_id": "watchpoints",
        "epistemic_status": "scenario",
        "text": "Scenario: if reservoir storage falls below 50 percent of capacity before 2026-03-20, a statutory rationing review would be triggered under Meridia water law as characterized in the admitted records.",
        "support_record_ids": [
          "record:basin_gauge_series_w10"
        ],
        "assumptions": [
          "The observed drawdown of roughly 7.6 points per 30 hours continues.",
          "No new inflow event or emergency order intervenes."
        ],
        "watchpoints": [
          "The next Meridia Water Authority bulletin.",
          "The week-11 Basin Hydrology Office gauge release.",
          "Whether the Coastal Wire and Harborview copies publish correction 114."
        ]
      },
      {
        "statement_id": "stmt:lim_syndication",
        "section_id": "limitations",
        "epistemic_status": "observed",
        "text": "As of the context cutoff, neither the Coastal Wire syndication nor the Harborview reprint had carried correction 114; readers of those copies still see the erroneous 40 percent figure.",
        "support_record_ids": [
          "record:coastal_wire_5521",
          "record:harborview_reprint_302",
          "record:ledger_correction_114"
        ]
      },
      {
        "statement_id": "stmt:lim_families",
        "section_id": "limitations",
        "epistemic_status": "observed",
        "text": "Three publications carried the same original report; they belong to one provenance family and count once in every corroboration judgment in this Brief.",
        "support_record_ids": [
          "record:coastal_wire_5521",
          "record:harborview_reprint_302",
          "record:ledger_report_1088"
        ]
      }
    ],
